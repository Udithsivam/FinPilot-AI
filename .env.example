# Copy to .env and adjust for your environment.

# Defaults to a local SQLite file if unset. For production, point at Postgres:
# DATABASE_URL=postgresql://finpilot:finpilot@localhost:5432/finpilot
DATABASE_URL=sqlite:///./backend/finpilot.db

SECRET_KEY=change-this-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated emails allowed to call admin-only endpoints
# (/monitoring/*, /mlops/*). Unset = nobody can access them.
ADMIN_EMAILS=admin@example.com

# Optional: enables a real generative LLM provider for POST /ai/chat.
# Without either, the assistant falls back to a deterministic
# extractive/template synthesizer (see src/rag/providers.py) — never a
# fabricated "AI" response.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
